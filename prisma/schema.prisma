  officeCode     String           @map("office_code")
  name           String
  officeType     OtecOfficeType   @map("office_type")
  status         OtecOfficeStatus @default(DRAFT)
  street         String
  city           String
  commune        String
  region         String
  country        String           @default("CL")
  postalCode     String?          @map("postal_code")
  email          String?
  phone          String?
  validFrom      DateTime?        @map("valid_from") @db.Date
  validUntil     DateTime?        @map("valid_until") @db.Date
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  version        Int              @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profile      OtecProfile  @relation(fields: [otecProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, validUntil])
  @@index([organizationId, deletedAt])
  @@index([otecProfileId])
  @@map("otec_offices")
}

model LegalRepresentative {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  otecProfileId         String    @map("otec_profile_id") @db.Uuid
  firstName             String    @map("first_name")
  lastName              String    @map("last_name")
  taxId                 String    @map("tax_id")
  email                 String?
  phone                 String?
  roleTitle             String    @map("role_title")
  validFrom             DateTime? @map("valid_from") @db.Date
  validUntil            DateTime? @map("valid_until") @db.Date
  active                Boolean   @default(true)
  appointmentDocumentId String?   @map("appointment_document_id") @db.Uuid
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")
  version               Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profile      OtecProfile  @relation(fields: [otecProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, active])
  @@index([organizationId, validUntil])
  @@index([organizationId, deletedAt])
  @@index([otecProfileId])
  @@map("legal_representatives")
}

model OtecResolution {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String               @map("organization_id") @db.Uuid
  otecProfileId          String               @map("otec_profile_id") @db.Uuid
  resolutionType         OtecResolutionType   @map("resolution_type")
  resolutionNumber       String               @map("resolution_number")
  issuingAuthority       String               @map("issuing_authority")
  issuedAt               DateTime             @map("issued_at") @db.Date
  validFrom              DateTime?            @map("valid_from") @db.Date
  validUntil             DateTime?            @map("valid_until") @db.Date
  status                 OtecResolutionStatus @default(DRAFT)
  scope                  String?
  supersedesResolutionId String?              @map("supersedes_resolution_id") @db.Uuid
  documentId             String?              @map("document_id") @db.Uuid
  notes                  String?
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  deletedAt              DateTime?            @map("deleted_at")
  version                Int                  @default(1)

  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profile              OtecProfile      @relation(fields: [otecProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supersedesResolution OtecResolution?  @relation("ResolutionSupersession", fields: [supersedesResolutionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supersededBy         OtecResolution[] @relation("ResolutionSupersession")

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, validUntil])
  @@index([organizationId, deletedAt])
  @@index([otecProfileId])
  @@index([supersedesResolutionId])
  @@map("otec_resolutions")
}
