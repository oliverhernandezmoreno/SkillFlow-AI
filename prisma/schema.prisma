  senceDocuments            SenceDocument[]    @relation("SenceDocumentFile")

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([uploadedByUserId])
  @@index([entityType, entityId])
  @@index([fileName])
