{
  "name": "skillflow-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SkillFlow AI backend base using Node.js, TypeScript, Express, Prisma, and PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "DATABASE_URL=\"${DATABASE_URL_TEST:-${DATABASE_URL:-postgresql://postgres:postgres@localhost:5433/skillflow?schema=public}}\" sh -c \"prisma migrate deploy && vitest run --config vitest.e2e.config.ts\"",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "DATABASE_URL=\"postgresql://postgres:postgres@localhost:5433/skillflow?schema=public\" prisma validate",
    "seed:demo": "DATABASE_URL=\"${DATABASE_URL_DEMO:-${DATABASE_URL:-postgresql://postgres:postgres@localhost:5433/skillflow?schema=public}}\" tsx prisma/seed-demo.ts",
    "seed:demo-access": "tsx prisma/seed-demo-access.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^6.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
